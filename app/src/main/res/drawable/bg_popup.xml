<?xml version="1.0" encoding="utf-8"?>
<!-- Menu panel: the dialog colour with a hairline, so it stays visible on black in dark mode. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/panel_bg" />
    <stroke
        android:width="@dimen/hairline"
        android:color="@color/divider" />
    <corners android:radius="@dimen/field_radius" />
    <padding
        android:bottom="4dp"
        android:top="4dp" />
</shape>
