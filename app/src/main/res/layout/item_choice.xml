<?xml version="1.0" encoding="utf-8"?>
<!-- One option in the "Choose what to check" dialog. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:minHeight="@dimen/button_height"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp"
    tools:ignore="Overdraw">
    <!-- The background is a press ripple, transparent until touched. -->

    <TextView
        android:id="@+id/choice_value"
        style="@style/VTChecker.Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:maxLines="2"
        android:textDirection="ltr"
        tools:text="https://example.com/login" />

    <TextView
        android:id="@+id/choice_type"
        style="@style/VTChecker.Text.Footnote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        tools:text="Link" />
</LinearLayout>
