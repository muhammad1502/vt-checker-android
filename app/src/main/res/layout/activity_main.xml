<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    tools:ignore="MergeRootFrame">
    <!-- A real root (not <merge>) so the window insets listener has its own view. -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter"
                android:paddingTop="48dp"
                android:paddingEnd="@dimen/gutter"
                android:paddingBottom="32dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/content_max_width">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_brand_mark" />

                <TextView
                    style="@style/VTChecker.Text.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/hero_title" />

                <TextView
                    style="@style/VTChecker.Text.Subhead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/hero_subtitle" />

                <LinearLayout
                    android:id="@+id/check_card"
                    style="@style/VTChecker.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp">

                    <TextView
                        style="@style/VTChecker.Text.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/check_title" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/input_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="@string/check_hint"
                        app:endIconContentDescription="@string/paste"
                        app:endIconDrawable="@drawable/ic_paste"
                        app:endIconMode="custom">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/input"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionGo"
                            android:importantForAutofill="no"
                            android:inputType="textUri|textNoSuggestions"
                            android:minHeight="56dp"
                            android:textAppearance="@style/TextAppearance.VTChecker.Body"
                            android:textColor="@color/text" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/status"
                        style="@style/VTChecker.Text.Footnote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:text="@string/check_helper" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/check_button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/check_on_virustotal"
                        app:icon="@drawable/ic_search" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/howto_card"
                    style="@style/VTChecker.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <TextView
                        style="@style/VTChecker.Text.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/howto_title" />

                    <LinearLayout
                        android:id="@+id/steps"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        style="@style/VTChecker.Text.Footnote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="@string/howto_share" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/types_card"
                    style="@style/VTChecker.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap">

                    <TextView
                        style="@style/VTChecker.Text.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/types_title" />

                    <LinearLayout
                        android:id="@+id/types"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/privacy_card"
                    style="@style/VTChecker.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/card_gap"
                    android:paddingBottom="16dp">

                    <TextView
                        style="@style/VTChecker.Text.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_title" />

                    <TextView
                        style="@style/VTChecker.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/privacy_body_1" />

                    <TextView
                        style="@style/VTChecker.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/privacy_body_2" />

                    <TextView
                        android:id="@+id/privacy_link"
                        style="@style/VTChecker.Text.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:drawablePadding="4dp"
                        android:text="@string/privacy_link"
                        app:drawableEndCompat="@drawable/ic_open_external"
                        app:drawableTint="@color/link" />
                </LinearLayout>

                <TextView
                    android:id="@+id/footer_version"
                    style="@style/VTChecker.Text.Legal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    tools:text="VT Checker 2.0 by Ninpo Inc." />

                <TextView
                    style="@style/VTChecker.Text.Legal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/footer_disclaimer" />

                <TextView
                    android:id="@+id/licenses_link"
                    style="@style/VTChecker.Text.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/footer_licenses"
                    android:textAppearance="@style/TextAppearance.VTChecker.Legal" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Content scrolls under the status bar; this keeps the clock and icons readable. -->
    <View
        android:id="@+id/status_bar_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@color/status_bar_scrim" />
</FrameLayout>
