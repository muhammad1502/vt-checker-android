<?xml version="1.0" encoding="utf-8"?>
<!-- One numbered step in "Use it in any app". Read by TalkBack as a single item. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:orientation="horizontal"
    android:paddingTop="@dimen/row_padding_v"
    android:paddingBottom="@dimen/row_padding_v"
    android:screenReaderFocusable="true"
    tools:targetApi="28">

    <TextView
        android:id="@+id/step_number"
        style="@style/Scout.Text.Badge"
        android:layout_width="@dimen/badge_size"
        android:layout_height="@dimen/badge_size"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        tools:text="1" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/step_title"
            style="@style/Scout.Text.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Select the text" />

        <TextView
            android:id="@+id/step_body"
            style="@style/Scout.Text.Footnote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            tools:text="Long-press a link, domain, IP address or file hash." />
    </LinearLayout>
</LinearLayout>
